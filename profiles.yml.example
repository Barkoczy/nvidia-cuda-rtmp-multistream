# Stream profiles configuration
# Streaming keys are loaded from Docker secrets using naming convention: {profile}_{service}_key
# Example: For profile "gaming" and service "youtube", the key is read from /run/secrets/gaming_youtube_key

gaming:
  youtube:
    url: rtmp://a.rtmp.youtube.com/live2
    bitrate: 40000k
    framerate: 60
    gopSize: 120
    preset: fast
    profile: main
  twitch:
    url: rtmp://live.twitch.tv/app
    bitrate: 8000k
    framerate: 60
    gopSize: 120
    preset: fast
    profile: high
    scale: 1920:1080
  kick:
    url: rtmp://rtmp.kick.com/live
    bitrate: 8000k
    framerate: 60
    gopSize: 120
    preset: fast
    profile: high
    scale: 1920:1080
  x:
    url: rtmp://rtmp.x.com/live
    bitrate: 12000k
    framerate: 60
    gopSize: 180
    preset: fast
    profile: high
    scale: 1280:720

events:
  youtube:
    url: rtmp://a.rtmp.youtube.com/live2
    bitrate: 40000k
    framerate: 60
    gopSize: 120
    preset: fast
    profile: main
